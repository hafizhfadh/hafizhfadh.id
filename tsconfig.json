{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"./worker-configuration.d.ts"
		],
		"paths": {
			"#lib": ["./src/lib/index.ts", "./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": [".svelte-kit"]
}
